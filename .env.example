# Backend (also ok in backend/.env)
FINNHUB_API_KEY=
FIREBASE_PROJECT_ID=

# Firestore trading ledger (required on Vercel; optional locally → SQLite fallback)
# Paste the full service-account JSON as one line, OR set a file path:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Auth notes (Firebase console):
# - Enable Email/Password and Google under Authentication → Sign-in method
# - Add localhost + your Vercel domain under Authentication → Settings → Authorized domains
# - Deploy firestore.rules so clients cannot write cash/holdings