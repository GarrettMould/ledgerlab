rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    // Shared classroom catalogs (teacher-added tickers + approved closet creations).
    // Writes go through Admin SDK / Flask only.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /classes/{classId} {
      // Invite links look up a class by inviteCode BEFORE the student signs in.
      // Class docs are OK to read publicly; roster/cash stay protected below.
      allow read: if true;
      allow create: if signedIn();
      // closetItems are published only via Admin SDK (AI creator).
      allow update: if signedIn()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['closetItems']);
      allow delete: if signedIn();

      match /students/{studentId} {
        allow read: if signedIn();
        // Cash + holdingsCount are written by the Admin SDK (Flask ledger) only.
        allow create: if signedIn();
        allow update: if signedIn()
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['cash', 'holdingsCount']);
        allow delete: if signedIn();

        match /holdings/{ticker} {
          allow read: if signedIn();
          allow write: if false;
        }
        match /snapshots/{snapId} {
          allow read: if signedIn();
          allow write: if false;
        }

        // Login analytics — students append their own login events.
        match /logins/{loginId} {
          allow read: if signedIn();
          allow create: if signedIn();
          allow update, delete: if false;
        }

        // Per-student trade log (written by Admin SDK / Flask).
        match /trades/{tradeId} {
          allow read: if signedIn();
          allow write: if false;
        }

        match /transfers/{transferId} {
          allow read: if signedIn();
          allow create, update: if signedIn();
          allow delete: if false;
        }
      }

      // Class-wide trade log (written by Admin SDK / Flask).
      match /trades/{tradeId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Student stock add-requests for the teacher (legacy per-class path).
      match /stockRequests/{requestId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.query is string
          && request.resource.data.query.size() > 0
          && request.resource.data.query.size() <= 80
          && request.resource.data.status == 'pending';
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt'])
          && request.resource.data.status in ['pending', 'done', 'dismissed'];
        allow delete: if isTeacher();
      }

      // Closet crew job board (written by Admin SDK / Flask).
      match /crewJobs/{crewJobId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'body', 'authorName', 'authorId', 'authorRole', 'createdAt'
          ])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 400
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 48
          && request.resource.data.authorRole in ['student', 'teacher'];
        allow update: if false;
        allow delete: if isTeacher();
      }

      match /threads/{threadId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.authorName is string
          && request.resource.data.authorRole in ['student', 'teacher'];
        allow update: if signedIn();
        allow delete: if isTeacher()
          && !(resource.data.isStarter == true);

        match /posts/{postId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 400
            && request.resource.data.authorName is string
            && request.resource.data.authorRole in ['student', 'teacher'];
          allow update: if false;
          allow delete: if isTeacher();
        }
      }

      // Head-to-head match requests / accepted battles for a class season.
      match /h2hMatches/{matchId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
            'seasonId', 'fromId', 'toId', 'status'
          ])
          && request.resource.data.seasonId is string
          && request.resource.data.fromId is string
          && request.resource.data.toId is string
          && request.resource.data.fromId != request.resource.data.toId
          && request.resource.data.status == 'pending';
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'respondedAt', 'tickersFrom', 'tickersTo'])
          && request.resource.data.status in ['pending', 'accepted', 'declined'];
        allow delete: if isTeacher();
      }
    }

    // Aggregate student stock suggestions (all classes).
    match /stockRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.query is string
        && request.resource.data.query.size() > 0
        && request.resource.data.query.size() <= 80
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['pending', 'done', 'dismissed'];
      allow delete: if isTeacher();
    }

    // Aggregate student bug reports (all classes).
    match /bugReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 400
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['pending', 'done', 'dismissed'];
      allow delete: if isTeacher();
    }
  }
}
