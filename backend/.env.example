# Free key from https://finnhub.io/register
FINNHUB_API_KEY=

# Preferred for AI closet parts recipes (Create an Item → Claude Sonnet 5)
# https://console.anthropic.com/ → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fallback for closet recipes + optional classroom news / legacy image sprites
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional — Meshy organic text-to-3D (if set, preferred over blocky)
# https://www.meshy.ai/api
MESHY_API_KEY=

# Firestore trading ledger (cash / holdings / snapshots)
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
# Storage bucket for AI closet GLBs (e.g. ledgerlab-2501e-closet or *.firebasestorage.app)
# FIREBASE_STORAGE_BUCKET=
